{
  "name": "prosemirror-css-custom-highlights",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite demo --open",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:safari",
    "test:soak": "FUZZ_SEEDS=${FUZZ_SEEDS:-25} vitest run --project ${PROJECT:-safari} test/fuzz.test.ts -t soak",
    "bench:paint": "PAINT_BENCH=1 vitest run --project ${PROJECT:-safari} --api.allowWrite test/paint.test.ts",
    "test:fuzz": "vitest run --project ${PROJECT:-safari} test/fuzz.test.ts",
    "test:unit": "vitest run --project ${PROJECT:-safari} test/regressions.test.ts test/clicks.test.ts test/composition.test.ts test/inclusive.test.ts test/properties.test.ts test/viewport.test.ts"
  },
  "author": "Jeff Sisson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saranrapjs/prosemirror-css-custom-highlights.git"
  },
  "homepage": "https://github.com/saranrapjs/prosemirror-css-custom-highlights#readme",
  "bugs": {
    "url": "https://github.com/saranrapjs/prosemirror-css-custom-highlights/issues"
  },
  "description": "A ProseMirror plugin that renders inline-style decorations using the CSS Custom Highlights API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/highlights.d.ts",
      "import": "./dist/highlights.js"
    }
  },
  "types": "./dist/highlights.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@vitest/browser-webdriverio": "^5.0.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.41.4",
    "typescript": "^7.1.0-beta",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webdriverio": "^10.1.0"
  },
  "peerDependencies": {
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.4"
  }
}
